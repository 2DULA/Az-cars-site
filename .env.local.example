# Carapis API key — get this from https://my.carapis.com
CARAPIS_API_KEY=your_carapis_api_key_here
CARAPIS_BASE_URL=https://carapis.com

# Supabase — get these from https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role — server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
